# LuceneServer.NET Admin UI container image (multi-stage)
#
#   docker build -f Dockerfile.admin -t luceneserver-net-admin .
#   docker run -p 8081:8080 -v luceneserver-admin-data:/data \
#     -e Admin__Authentication__Users__0__Name=admin \
#     -e Admin__Authentication__Users__0__PasswordHash='pbkdf2-sha256$...' \
#     luceneserver-net-admin
#
# Create a password hash: docker run --rm luceneserver-net-admin --hash-password <password>
# Data: /data (SQLite database admin.db and the data protection keys for the stored instance secrets) - mount a volume.

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/LuceneServerNET.Admin/LuceneServerNET.Admin.csproj src/LuceneServerNET.Admin/
COPY src/LuceneServerNET.Client/LuceneServerNET.Client.csproj src/LuceneServerNET.Client/
COPY src/LuceneServerNET.Core/LuceneServerNET.Core.csproj src/LuceneServerNET.Core/
COPY src/aspire/LuceneServerNET.ServiceDefaults/LuceneServerNET.ServiceDefaults.csproj src/aspire/LuceneServerNET.ServiceDefaults/
COPY src/Directory.Build.props src/
RUN dotnet restore src/LuceneServerNET.Admin/LuceneServerNET.Admin.csproj

COPY LICENSE ./
COPY src/ src/
RUN dotnet publish src/LuceneServerNET.Admin/LuceneServerNET.Admin.csproj -c Release -o /app --no-restore -p:GeneratePackageOnBuild=false \
    && rm -f /app/appsettings.Development.json

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app

ENV ASPNETCORE_HTTP_PORTS=8080 \
    ADMIN__DATAPATH=/data

RUN mkdir -p /data && chown -R app:app /data
VOLUME ["/data"]

COPY --from=build /app .
COPY LICENSE ./

USER app
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080 && printf "GET /health HTTP/1.0\r\nHost: localhost\r\n\r\n" >&3 && head -n 1 <&3 | grep -q " 200 "' || exit 1

ENTRYPOINT ["dotnet", "LuceneServerNET.Admin.dll"]
