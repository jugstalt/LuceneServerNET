# Variables for docker-compose.yml. Copy this file to .env (same folder) and fill in the values.
# .env is ignored by git: it holds the secrets of your installation.
#
# Values in single quotes: the hashes contain '$', which docker compose would otherwise interpolate.

# image version (git tag without 'v', e.g. 3.0.0) or latest
LUCENE_TAG=latest

# host ports
LUCENE_PORT=8080
ADMIN_PORT=8081

# --- LuceneServer.NET: API client used by the admin UI ---------------------------------------------
LUCENE_ADMIN_CLIENT_ID=admin-ui
# the secret in plain text (the admin UI sends it to the server) - NOT the login password below
LUCENE_ADMIN_CLIENT_SECRET='change-me'
# hash of exactly LUCENE_ADMIN_CLIENT_SECRET (the server only knows the hash; a different value => 401 in the admin UI):
#   docker run --rm ghcr.io/jugstalt/luceneserver-net --hash-secret '<value of LUCENE_ADMIN_CLIENT_SECRET>'
LUCENE_ADMIN_CLIENT_SECRET_HASH='pbkdf2-sha256$...'

# --- admin UI login --------------------------------------------------------------------------------
ADMIN_USER=admin
# hash of the login password:
#   docker run --rm ghcr.io/jugstalt/luceneserver-net-admin --hash-password 'my password'
ADMIN_PASSWORD_HASH='pbkdf2-sha256$...'
