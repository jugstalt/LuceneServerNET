{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Admin": {
    // folder for the SQLite database (admin.db) and the data protection keys
    "DataPath": "_data",
    "Authentication": {
      // Local (users below), Oidc or None (no login, only for local development!)
      "Type": "Local",
      "Users": [
        // { "Name": "admin", "PasswordHash": "pbkdf2-sha256$..." }  create a hash with: LuceneServerNET.Admin --hash-password <password>
      ],
      "Oidc": {
        "Authority": "",
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": [ "openid", "profile" ],
        // optional: only users with this role claim may log in
        "RequiredRole": ""
      }
    },
    // instances from the configuration (read only in the UI). More instances can be added in the UI.
    "Instances": [
      // { "Name": "local", "Url": "http://localhost:5000", "ClientId": "", "ClientSecret": "" }
    ]
  }
}
