<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LuceneServerNET.Admin</AssemblyName>
    <UserSecretsId>b7d3a8e2-4c61-4f0b-9a7e-2d5c8e1f6a34</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Services\Repository\Sql\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Proj4Net.Core" Version="2.26.2401" />
    <PackageReference Include="SpatialNET.Core" Version="0.9.0-preview.1" />
    <PackageReference Include="SpatialNET.Extensions" Version="0.9.0-preview.1" />
    <PackageReference Include="SpatialNET.Imp" Version="0.9.0-preview.1" />
    <PackageReference Include="SpatialNET.IO" Version="0.9.0-preview.1" />
    <!-- transitive from Microsoft.Data.SqlClient (9.0.x has known vulnerabilities: GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\aspire\LuceneServerNET.ServiceDefaults\LuceneServerNET.ServiceDefaults.csproj" />
    <ProjectReference Include="..\LuceneServerNET.Client\LuceneServerNET.Client.csproj" />
    <ProjectReference Include="..\LuceneServerNET.Core\LuceneServerNET.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LuceneServerNET.Tests" />
  </ItemGroup>

</Project>
