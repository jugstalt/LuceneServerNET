@page "/jobs"
@using LuceneServerNET.Admin.Services.Repository
@implements IDisposable
@inject IAdminRepositoryService Repository
@inject ImportJobRunner Runner
@inject AuditService Audit
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider Authentication

<PageTitle>Import jobs · LuceneServer.NET Admin</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h4">Import jobs</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FileOpen" Href="jobs/import-gview" Class="mr-2">Import gView configuration</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="jobs/new">New job</MudButton>
</MudStack>
<MudText Typo="Typo.body2" Class="mb-4">Imports from a database query, on a schedule or manually (run now). Jobs only run while the admin application runs; with "catch up" a missed run is started once at startup.</MudText>

<MudTable Items="_jobs" Hover="true" Dense="true" Loading="_loading">
    <HeaderContent>
        <MudTh>Job</MudTh>
        <MudTh>Target</MudTh>
        <MudTh>Schedule</MudTh>
        <MudTh>Last run</MudTh>
        <MudTh>Next run</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            <MudLink Href="@($"jobs/{context.Id}")"><b>@context.Name</b></MudLink>
            @if (!context.Enabled)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">disabled</MudChip>
            }
        </MudTd>
        <MudTd><span class="mono">@context.Instance / @context.Target</span> <MudText Typo="Typo.caption">@context.Mode</MudText></MudTd>
        <MudTd>
            @if (context.HasSchedule)
            {
                <span class="mono">@context.Cron</span> <MudText Typo="Typo.caption">@(context.TimeZone ?? "UTC")</MudText>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">manual</MudChip>
            }
        </MudTd>
        <MudTd>
            @if (Runner.IsRunning(context.Id))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Info" Icon="@Icons.Material.Filled.Sync">@(Runner.IsQueued(context.Id) ? "running, 1 queued" : "running")</MudChip>
                @if (Runner.GetProgress(context.Id) is { } progress)
                {
                    @if (progress.Percent is { } percent)
                    {
                        <MudProgressLinear Color="Color.Info" Value="percent" Class="my-1" Style="max-width:220px" />
                    }
                    <MudText Typo="Typo.caption" Style="display:block">@progress.Text</MudText>
                }
            }
            else if (_lastRuns.TryGetValue(context.Id, out var run))
            {
                <JobStatusChip Status="@run.Status" />
                <MudText Typo="Typo.caption">@Format.Date(run.StartedUtc)</MudText>
            }
        </MudTd>
        <MudTd>@(context.Enabled && context.HasSchedule ? NextRun(context) : "–")</MudTd>
        <MudTd Style="text-align:right">
            <MudTooltip Text="Run now">
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" Disabled="Runner.IsRunning(context.Id)" OnClick="() => RunNowAsync(context)" aria-label="Run now" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>No import jobs yet.</MudText></NoRecordsContent>
</MudTable>

@code {
    private IReadOnlyList<ImportJobRecord> _jobs = [];
    private IReadOnlyDictionary<long, ImportJobRunRecord> _lastRuns = new Dictionary<long, ImportJobRunRecord>();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        Runner.RunChanged += OnRunChanged;
        Runner.ProgressChanged += OnProgressChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _jobs = await Repository.GetImportJobsAsync();
        _lastRuns = await Repository.GetLastImportJobRunsAsync();
        _loading = false;
    }

    private static string NextRun(ImportJobRecord job)
    {
        try
        {
            var next = ImportJobRunner.NextOccurrences(job.Cron, job.TimeZone, DateTime.UtcNow, 1).FirstOrDefault();
            return next == default ? "–" : Format.Date(next);
        }
        catch
        {
            return "invalid schedule";
        }
    }

    private async Task RunNowAsync(ImportJobRecord job)
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name ?? "";
        Snackbar.Add($"Job {job.Name} started", Severity.Info);
        _ = Task.Run(async () =>
        {
            try
            {
                var run = await Runner.RunAsync(job.Id, String.IsNullOrEmpty(user) ? "manual" : user);
                await InvokeAsync(() => Snackbar.Add($"Job {job.Name}: {run.Status}", run.Status is ImportJobStatus.Succeeded ? Severity.Success : Severity.Warning));
            }
            catch (Exception ex)
            {
                await InvokeAsync(() => Snackbar.Add(ex.Message, Severity.Error));
            }
        });
        await Task.Delay(100);
    }

    private void OnRunChanged(long jobId) => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private void OnProgressChanged(long jobId) => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Runner.RunChanged -= OnRunChanged;
        Runner.ProgressChanged -= OnProgressChanged;
    }
}
