    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\aspire\LuceneServerNET.ServiceDefaults\LuceneServerNET.ServiceDefaults.csproj" />
    <ProjectReference Include="..\LuceneServerNET.Core\LuceneServerNET.Core.csproj" />
    <ProjectReference Include="..\LuceneServerNET.Engine\LuceneServerNET.Engine.csproj" />
    <ProjectReference Include="..\LuceneServerNET.Parse\LuceneServerNET.Parse.csproj" />
  </ItemGroup>

</Project>
